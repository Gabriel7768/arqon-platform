# ─────────────────────────────────────────────────────────────────────────
# ARQON Platform — Environment Variables
# ─────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in real values.
# Never commit `.env`. The gitleaks pre-commit hook will reject secrets.
#
# All secrets are loaded fail-closed: the server throws on startup (or on
# first use) if a required value is missing or empty — there is NO insecure
# fallback.

# ── API Server (api-server) ─────────────────────────────────────────────

# Required — server will not start without this.
PORT=12000

# Required — Postgres connection string (Supabase pooler).
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Required — JWT signing secret. Use a strong random string (≥32 chars).
# Generate with: openssl rand -base64 48
SESSION_SECRET=

# Required in production — comma-separated list of allowed frontend origins.
# CORS rejects any origin not in this list.
WEB_ORIGIN=http://localhost:5173

# Recommended — "production" in prod (controls log level + error detail).
NODE_ENV=development

# Optional — pino log level (defaults to "info").
LOG_LEVEL=info

# ── Billing (Abacatepay) ─────────────────────────────────────────────────
# All required if billing routes are used. Fail-closed on first billing call.

# API key from the Abacatepay dashboard.
ABACATEPAY_API_KEY=

# Webhook secret configured in the Abacatepay dashboard. Used to verify
# inbound webhook signatures (HMAC-SHA256) and query-string secrets.
ABACATEPAY_WEBHOOK_SECRET=

# Product IDs for each plan (created with a MONTHLY cycle in the dashboard).
ABACATEPAY_PRODUCT_STARTER=
ABACATEPAY_PRODUCT_CORE=
ABACATEPAY_PRODUCT_GROWTH=
ABACATEPAY_PRODUCT_INTELLIGENCE=

# ── Frontend (web) ───────────────────────────────────────────────────────
# The frontend uses Vercel rewrites to proxy /api/* to the Render backend,
# so no API URL env var is needed in the frontend.

# Dev server port (Vite). Defaults to 3000.
PORT=3000

# Base path for sub-path deploys. Defaults to "/".
BASE_PATH=/
